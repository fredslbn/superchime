#
# KernelSU
#
CONFIG_KSU=m
CONFIG_KSU_HACK_ARM64_BRANCH_LINK=y
CONFIG_KSU_LSM_SECURITY_HOOKS=y
CONFIG_KSU_FEATURE_SULOG=y
CONFIG_KSU_HOSTSREDIRECT=y
CONFIG_KSU_THRONE_TRACKER_ALWAYS_THREADED=y
CONFIG_KSU_COMPILE_AS_C23=y
CONFIG_KSU_HEURISTIC_IN_TREE_BUILD=y

CONFIG_LTO_CLANG=y
CONFIG CFI_CLANG=y
# CONFIG SHADOW_CALL_STACK is not set
# CONFIG_THINLTO is not set

CONFIG_DEBUG_KERNEL=n
CONFIG_MODVERSIONS=n

CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=n
CONFIG_DEBUG_FS=n
